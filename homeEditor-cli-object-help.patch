diff --git a/docs/CLI_OBJECT_HELP.md b/docs/CLI_OBJECT_HELP.md
new file mode 100644
--- /dev/null
+++ b/docs/CLI_OBJECT_HELP.md
@@ -0,0 +1,53 @@
+# HomeEditor Script: object-container help
+
+The SCRIPT terminal follows the object naming convention: constructor `Editor()` has its
+primary instance `oEditor`, `QSVG()` has `oQSVG`, and `HomeEditorScript()` has
+`oHomeEditorScript`.
+
+## Read help directly from the live object instances
+
+```text
+print(oEditor.help)
+print(oEditor.wall.help)
+print(oEditor.wall.help.summary)
+print(oQSVG.help)
+print(oQSVG.measure.help)
+print(oHomeEditorScript.addWall.help)
+```
+
+The `Editor` and `QSVG` constructors attach `.help` descriptors to their callable methods.
+Their instance-level `.help` properties compile live, read-only catalogues of those
+method descriptors. The CLI does not maintain a separate, potentially outdated list.
+The descriptors contain method signatures, parameter descriptions and examples.
+For instance, `oEditor.wall.help` documents the `new oEditor.wall(...)` constructor,
+and explains the difference between constructing a wall object and adding it to
+the working-area canvas.
+
+`print(...)` is **read-only**. It resolves documented properties of the three named
+object instances, but does not evaluate arbitrary JavaScript or execute methods.
+It rejects function calls, global-object access and unsafe prototype paths.
+
+## Editing the canvas
+
+Use the existing, validated editing commands for actual canvas changes:
+
+```text
+wall add 100 100 300 100 20 250
+wall set 0 height 280
+object add plug 200 300
+walls
+objects
+```
+
+These operations update the actual canvas and use HomeEditor's history.
+Constructing `new oEditor.wall(...)` by itself is **not** a drawing operation:
+a caller using the JavaScript API must also append the wall to `WALLS`, redraw,
+and save. The restricted Script terminal does not execute arbitrary JavaScript
+expressions; see the separate `wall add` command in the CLI.
+
+The original `help editor`, `help editor.wall`, `help qsvg.create`, etc. remain
+available as compatibility aliases, while `help oEditor.wall` and
+`help oQSVG.create` are the preferred object-based forms.
+
+Open `test/cli-object-help.html` in a browser to test the help interface without
+Node.js, a server, or dependencies.
diff --git a/test/cli-object-help.html b/test/cli-object-help.html
new file mode 100644
--- /dev/null
+++ b/test/cli-object-help.html
@@ -0,0 +1,89 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>HomeEditor CLI object-help regression</title>
+<style>
+body { font: 15px system-ui,sans-serif; max-width: 850px; margin: 2em auto; padding: 0 1em }
+li { padding: .24em 0 } .pass { color: #176b3e } .fail { color: #ad1e1e }
+</style>
+</head>
+<body>
+<h1>CLI object-container help</h1>
+<ol id="results"></ol><p id="summary" role="status"></p>
+<script>
+var WALLS = [], OBJDATA = [], ROOM = [], meter = 60, wallSize = 20, mode = 'select_mode';
+var saveCount = 0, redrawCount = 0;
+function save() { saveCount++; return true; }
+function rib() {}
+function isObjectsEquals(a,b) { return a===b; }
+</script>
+<script src="../res/qSVG.js"></script>
+<script src="../res/editor.js"></script>
+<script>
+// The real constructors are used. Stub only the SVG-redraw side effect.
+var originalArchitectHelp = oEditor.architect.help;
+oEditor.architect = function(walls)
+{
+    redrawCount++;
+    walls.forEach(function(wall)
+    {
+        if (!Number.isFinite(wall.start.x) || !Number.isFinite(wall.end.x) ||
+            !Number.isFinite(wall.thick) || wall.thick <= 0) throw new RangeError('Invalid wall');
+    });
+    return true;
+};
+oEditor.architect.help = originalArchitectHelp;
+</script>
+<script src="../res/HomeEditorScript.js"></script>
+<script>
+(function()
+{
+    var results = [], root = document.getElementById('results');
+    function check(name, passed)
+    {
+        var li = document.createElement('li');
+        li.className = passed ? 'pass' : 'fail';
+        li.textContent = (passed ? 'PASS: ' : 'FAIL: ') + name;
+        root.appendChild(li);
+        results.push(!!passed);
+    }
+    function fails(line)
+    {
+        try { oHomeEditorScript.execute(line); return false; }
+        catch (_) { return true; }
+    }
+    try
+    {
+        check('Instance catalogue exists', oEditor.help.container === 'oEditor');
+        check('Discovers live method descriptors', !!oEditor.help.methods.wall && !!oEditor.help.methods.architect);
+        check('Original method owns its help', oEditor.wall.help.syntax.indexOf('new oEditor.wall') === 0);
+        check('oEditor.help is printable', oHomeEditorScript.execute('print(oEditor.help)').container === 'oEditor');
+        check('Wall help is printable', oHomeEditorScript.execute('print(oEditor.wall.help)').syntax.includes('height'));
+        check('Nested text property is printable', typeof oHomeEditorScript.execute('print(oEditor.wall.help.summary)') === 'string');
+        check('QSVG help catalogue is live', !!oHomeEditorScript.execute('print(oQSVG.help)').methods.measure);
+        check('QSVG method help uses o-prefix', oHomeEditorScript.execute('print(oQSVG.measure.help)').syntax.includes('oQSVG.measure'));
+        check('Script method help is printable', oHomeEditorScript.execute('print(oHomeEditorScript.addWall.help)').syntax.includes('wall add'));
+        check('Canonical help command works', oHomeEditorScript.execute('help oEditor.wall').includes('new oEditor.wall'));
+        check('Legacy help command still works', oHomeEditorScript.execute('help editor.wall').includes('new oEditor.wall'));
